# Copy to .env and fill in every empty value. NEVER commit .env.
# Generate secrets (see docs/security-design.md section 3):
#   random string : python -c "import secrets; print(secrets.token_urlsafe(48))"
#   32-byte key   : python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"

ENVIRONMENT=development

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=securefiles
POSTGRES_USER=securefiles
POSTGRES_PASSWORD=
# Used when running the backend outside Docker (inside Compose it is built from the values above).
# Replace CHANGE_ME with the POSTGRES_PASSWORD value.
DATABASE_URL=postgresql+psycopg://securefiles:CHANGE_ME@localhost:5432/securefiles

# --- M1 Authentication -------------------------------------------------------
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- M2 / M3 Encryption & key management -----------------------------------------
# base64 of exactly 32 random bytes; encrypts users' RSA private keys at rest
MASTER_KEY_ENCRYPTION_KEY=
STORAGE_DIR=./data/files
MAX_UPLOAD_BYTES=26214400

# --- M6 Audit log ------------------------------------------------------------
# base64 of exactly 32 random bytes; HMAC key for the hash chain
AUDIT_HMAC_KEY=

# --- M7 Anomaly detection ----------------------------------------------------
MODEL_DIR=./data/models
ANOMALY_CONTAMINATION=0.05

# --- M8 LLM analysis ---------------------------------------------------------
# "disabled" makes /analysis return 503. Set a provider name, key and model to enable.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=

# --- M10 Transport -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,https://localhost
ENFORCE_HTTPS=false

# --- Frontend (Vite reads VITE_* from this file) ------------------------------
# The browser calls /api/v1 on the frontend origin; Vite proxies it to the backend.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
